# Copy to .env and edit. Every value below is optional; the defaults shown are
# what the service uses if the variable is absent.

# ---------------------------------------------------------------------------
# Chunking -- change these and re-ingest to compare configurations.
# ---------------------------------------------------------------------------
CHUNK_SIZE=550                 # target tokens per chunk (500-600 is the tuned range)
CHUNK_OVERLAP=120              # tokens repeated between adjacent chunks
MIN_CHUNK_SIZE=100             # stub chunks smaller than this are merged back

# ---------------------------------------------------------------------------
# Embeddings
#   auto                  -> Voyage if VOYAGE_API_KEY is set, else
#                            sentence-transformers if installed, else hashing
#   voyage                -> require Voyage (fails fast if unavailable)
#   sentence-transformers -> require local MiniLM
#   hashing               -> built-in lexical fallback: deterministic, offline,
#                            no model download. Fine for development and CI,
#                            not for production retrieval quality.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=auto
# VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large    # voyage-law-2 is worth trying on policy wordings
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
HASHING_DIMENSION=512

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
CHROMA_DIR=./chroma_db
COLLECTION_NAME=endorsement_chunks
FORCE_IN_MEMORY_STORE=false    # skip Chroma entirely (used by the test suite)

# ---------------------------------------------------------------------------
# Retrieval
# MIN_RELEVANCE gates the LLM call: below this cosine similarity, /ask returns
# the not-found answer without asking Claude. It is a cost optimisation, not the
# correctness mechanism -- bias it LOW. The value is specific to both the
# embedding provider and CHUNK_SIZE; see the README before changing either.
# ---------------------------------------------------------------------------
TOP_K=5
MIN_RELEVANCE=0.12

# ---------------------------------------------------------------------------
# Generation
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-opus-5
ANSWER_EFFORT=medium           # low | medium | high | xhigh | max
ANSWER_MAX_TOKENS=16000        # caps thinking + answer together

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800      # 50 MB
CORS_ALLOW_ORIGINS=*           # '*' lets you open frontend/index.html from disk
