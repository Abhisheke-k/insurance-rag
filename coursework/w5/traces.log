  "input_redacted": "Claim [CLAIM NUMBER REDACTED]. Water ingress on 16 March 2026; insured's stock was stored on racking 200mm above the finished floor level per their usual practice. Estimated damage GBP 115,590.",
  "redacted_fields": [
    "claim_number:CLM-2026-25075"
  ],
  "retrieval_mode": "hybrid_bm25_rrf",
